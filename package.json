{
  "name": "efactory-english-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "EFACTORY_PUBLICATION=preview ASTRO_TELEMETRY_DISABLED=1 astro dev --host 0.0.0.0",
    "build": "EFACTORY_PUBLICATION=preview ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 0.0.0.0",
    "test": "npm run build && playwright test",
    "build:production": "EFACTORY_PUBLICATION=production ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:preview": "EFACTORY_PUBLICATION=preview ASTRO_TELEMETRY_DISABLED=1 astro build"
  },
  "dependencies": {
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0"
  }
}
