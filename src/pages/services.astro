---
import { sitePath } from '../data/paths';
import { Image } from 'astro:assets';
import PageLayout from '../components/PageLayout.astro';
import NextStep from '../components/NextStep.astro';
import { homeImages, homeServices } from '../data/home';
const services = [
 { id: 'diy-support', title: 'Maintenance & parts fitting', label: 'SUPPORTED DIY', image: homeServices[0].image, alt: homeServices[0].alt, text: 'Work on the motorcycle you own in Japan, with equipment and practical guidance alongside you. Agree on the task, then work through the parts you can do with support where needed.', examples: ['Oil changes and chain cleaning or adjustment', 'Battery checks and brake maintenance support', 'Parts fitting, electrical accessories and wiring'], condition: 'Single sessions, passes and memberships cover selected tasks. Parts and consumables may cost extra.' },
 { id: 'repair-support', title: 'Falls, damage & things that feel wrong', label: 'ASSESS THE NEXT STEP', image: homeServices[1].image, alt: homeServices[1].alt, text: 'A fall, a damaged part or a handling concern can leave you unsure where to start. Arrange a visit to check the actual motorcycle and discuss repair, replacement or machining options.', examples: ['Explain what happened and the symptoms', 'Agree on an assessment and the support available', 'Confirm the work and costs before proceeding'], condition: 'Technical assessment and advice are paid services. Feasibility depends on the motorcycle and the issue.' },
 { id: 'installation-tyres', title: 'Tyres & workshop equipment', label: 'STAFF-OPERATED EQUIPMENT', image: homeServices[2].image, alt: homeServices[2].alt, text: 'Use the workshop as part of supported work, with the right preparation for your motorcycle. Staff operate the tyre changer; the arrangements for other tasks are agreed before work begins.', examples: ['Tyre changes and tyre-changer use', 'Check wheel, tyre and equipment compatibility', 'Confirm any parts, materials or preparation time'], condition: 'Selected tasks are available to single-session, pass and member users. Ask about separate parts or specialist charges.' },
 { id: 'custom-parts', title: 'Custom part design & fabrication', label: 'SPECIALIST PROJECTS', image: homeServices[3].image, alt: homeServices[3].alt, text: 'Bring a part idea or a problem that an off-the-shelf component does not solve. Discuss design, fabrication, welding and one-off machining with eFactory.', examples: ['Share the purpose, motorcycle and requirements', 'Discuss feasibility, materials and fitting', 'Agree on a project scope and individual quotation'], condition: 'Specialist work and materials may be quoted separately. Enquiring does not confirm that a project can be accepted.' },
 { id: 'ecu-support', title: 'ECU Flashing & setup', label: 'SPECIFICATION & PURPOSE', image: homeServices[4].image, alt: homeServices[4].alt, text: 'Explore ECU Flashing services that take the motorcycle’s specification and intended use into account. eFactory’s published approach emphasises rideability, particularly in motogymkhana.', examples: ['Model, year, ECU and modification checks', 'Discuss the riding characteristics you want to improve', 'Agree on compatibility, scope and pricing'], condition: 'Availability and additional charges are confirmed individually. No universal model coverage or performance result is promised.' },
 { id: 'riding-support', title: 'Gymkhana, riding & bike setup', label: 'MEMBER SUPPORT', image: homeServices[5].image, alt: homeServices[5].alt, text: 'Keep working on the relationship between you and your motorcycle. Riding and gymkhana advice, riding-position adjustments and suspension-setting enquiries are listed as member services.', examples: ['Talk through riding and setup concerns', 'Discuss a gymkhana or track-use project', 'Confirm the equipment and support available for your goal'], condition: 'Membership, scope and any specialist charges need to be confirmed. Specific track services are agreed individually.' },
];
---
<PageLayout title="Services" heading="Support for the bike you ride." description="Explore supported motorcycle maintenance, tyres, custom part fabrication, ECU and gymkhana enquiries at eFactory in Suzuka, welcoming riders from across Japan." intro="Workshop equipment, practical guidance and specialist knowledge—for maintaining, improving and understanding your motorcycle in Japan.">
  <figure slot="visual" class="page-photo"><Image src={homeImages.workshop} alt="A blue motorcycle and tools inside the eFactory workshop" width={800} widths={[480,800]} sizes="(max-width: 600px) calc(100vw - 40px), 450px" format="png" loading="eager" /><figcaption>Based in Suzuka. Welcoming riders from across Japan.</figcaption></figure>
  <div slot="intro-extra" class="inline-actions"><a class="button" href={sitePath('/pricing/')}>Compare prices <span class="arrow" aria-hidden="true"></span></a><a class="text-link" href={sitePath('/contact/')}>Discuss a visit <span class="arrow" aria-hidden="true"></span></a></div>
  <nav class="section-nav" aria-label="Service sections"><a href="#diy-support">DIY support</a><a href="#repair-support">Damage & repair</a><a href="#installation-tyres">Tyres</a><a href="#custom-parts">Custom parts</a><a href="#ecu-support">ECU</a><a href="#riding-support">Riding & setup</a><a href="#ssb-cst">SSB & CST</a></nav>
  <div class="responsibility-note"><strong>Who does the work?</strong><p>Supported DIY keeps you involved. Staff-operated equipment and specialist fabrication or ECU work have their own agreed scope. Confirm the responsibilities for your task before booking. Technical consultation is paid.</p></div>
  <div class="service-detail-grid">{services.map(service => <section class="service-detail" id={service.id}><div class="service-detail-heading"><Image src={service.image} alt={service.alt} width={88} widths={[88,176]} format="png" loading="lazy" /><div><p class="eyebrow">{service.label}</p><h2>{service.title}</h2></div></div><p>{service.text}</p><ul>{service.examples.map(example => <li>{example}</li>)}</ul><p class="service-condition">{service.condition}</p>{service.id === 'ecu-support' && <a class="text-link" href={sitePath('/ecu-tuning/')}>Explore ECU Flashing services <span class="arrow" aria-hidden="true"></span></a>}</section>)}</div>
  <section class="content-section" id="ssb-cst"><div class="section-heading"><div><p class="eyebrow">PARTS & TYRES</p><h2>SSB & CST enquiries</h2></div><p>Confirm availability and suitability<br />for your motorcycle.</p></div><div class="parts-grid"><article class="parts-card"><Image src={homeImages.ssbLogo} alt="SSB Sakuta Sports Bumper logo" width={180} format="png" loading="lazy" /><div><h3>SSB bumpers</h3><p>Sales, fitting and repair enquiries. Supported self-installation can also be discussed.</p><a class="text-link" href={sitePath('/contact/')}>Ask about SSB <span class="arrow" aria-hidden="true"></span></a></div></article><article class="parts-card"><Image src={homeImages.cstTyres} alt="CST tyre product image from the Japanese eFactory HOME" width={140} format="png" loading="lazy" /><div><Image class="cst-logo" src={homeImages.cstLogo} alt="CST" width={80} format="png" loading="lazy" /><h3>CST tyres</h3><p>12- and 17-inch products are listed. Confirm stock, specifications and tyre-change arrangements.</p><a class="text-link" href={sitePath('/contact/')}>Ask about CST <span class="arrow" aria-hidden="true"></span></a></div></article></div></section>
  <section class="content-section"><h2>Other workshop enquiries</h2><p>Motorcycle storage and transport of stored motorcycles within Suzuka are also listed on the Japanese site. Ask about availability, conditions and separate costs.</p></section>
  <NextStep />
</PageLayout>
