---
import { sitePath } from '../data/paths';
import PageLayout from '../components/PageLayout.astro';
import NextStep from '../components/NextStep.astro';
import PricingCards from '../components/PricingCards.astro';
import { pricing, yen } from '../data/site';
import { serviceAvailability } from '../data/services';
---
<PageLayout title="Pricing" heading="Clear prices. A practical start." description="Compare eFactory’s tax-inclusive first-visit trial, 90-minute sessions, passes and monthly membership prices. Check service eligibility and extra costs before booking." intro="Choose a first visit, a session when you need it, or ongoing support. Every price below includes Japanese consumption tax." eyebrow="PLANS & PRICING">
  <p slot="intro-extra" class="tax-badge">Total prices · Tax included · Extra parts and specialist work confirmed separately</p>
  <nav class="section-nav" aria-label="Pricing sections"><a href="#sessions">Visits & passes</a><a href="#compare">Compare sessions</a><a href="#membership">Membership</a><a href="#plan-services">Service eligibility</a><a href="#terms">Before booking</a></nav>
  <section id="sessions" class="content-section"><h2>Your visit, your choice.</h2><PricingCards /></section>
  <section id="compare" class="content-section"><div class="section-heading"><div><p class="eyebrow">COMPARE LIKE FOR LIKE</p><h2>One session at a time—or a pass.</h2></div></div><div class="table-wrap"><table class="comparison-table"><caption>Each single or pass session is {pricing.single.minutes} minutes. Passes are valid for {pricing.passes[0].validityMonths} months; confirm the start date and detailed conditions.</caption><thead><tr><th scope="col">Option</th><th scope="col">Total</th><th scope="col">Per session</th><th scope="col">Saving*</th></tr></thead><tbody><tr><th scope="row">Single</th><td>{yen(pricing.single.total)}</td><td>{yen(pricing.single.total)}</td><td>—</td></tr>{pricing.passes.map(pass => <tr><th scope="row">{pass.sessions}-session pass</th><td>{yen(pass.total)}</td><td>{yen(pass.total/pass.sessions)}</td><td>{yen(pricing.single.total*pass.sessions-pass.total)}</td></tr>)}</tbody></table></div><p class="price-note">*The total difference compared with buying the same number of single sessions. All amounts include tax. Parts, materials and separately quoted services may cost extra.</p></section>
  <section id="membership" class="content-section"><div class="section-heading"><div><p class="eyebrow">KEEP YOUR PROJECTS MOVING</p><h2>Monthly membership</h2></div><p>For an ongoing relationship<br />with the workshop.</p></div><div class="membership-cards">{pricing.memberships.map((plan,index) => <article class="membership-card"><span class="eyebrow">{index === 0 ? 'ONGOING SUPPORT' : 'BOOKING FLEXIBILITY'}</span><h3>{plan.label}</h3><p class="price">{yen(plan.monthly)}<span>/ month · total membership price · incl. tax</span></p><p>{index === 0 ? 'For ongoing maintenance, custom projects, riding and motorcycle setup enquiries.' : 'For ongoing projects with priority booking and additional consultation windows, arranged according to availability.'}</p><ul>{index === 0 ? <><li>Member-oriented planning and technical consultation</li><li>Parts selection and ongoing work records</li><li>Riding and setup enquiries within the available scope</li></> : <><li>Priority guidance to available appointment slots</li><li>Member consultation windows by arrangement</li><li>Discuss consecutive slots for longer projects</li></>}</ul><p class="service-condition">{index === 0 ? 'Confirm included usage, eligibility and subscription terms before joining.' : 'Priority booking does not guarantee your preferred time. Confirm availability and membership terms.'}</p><a class="text-link" href={sitePath('/contact/')}>Ask about {plan.label.toLowerCase()} <span class="arrow" aria-hidden="true"></span></a></article>)}</div><p class="price-note">Parts, consumables, materials and specialist work can be separate charges. Confirm the current monthly terms and session allowances. Confirm the current rates and applicable membership terms before joining.</p></section>
  <section id="plan-services" class="content-section"><h2>Which services fit your plan?</h2><div class="availability-list">{serviceAvailability.map(item => <article><div><h3>{item.service}</h3><span class="plan-label">{item.plans}</span></div><p>{item.note}</p></article>)}</div><p class="price-note">This is a guide to the services listed on the Japanese site. The motorcycle, task, equipment and plan determine what can be arranged.</p><a class="text-link section-link" href={sitePath('/services/')}>Explore the services <span class="arrow" aria-hidden="true"></span></a></section>
  <section id="terms" class="content-section"><h2>Confirm the full cost before booking.</h2><div class="note-grid"><article><h3>Visits & preparation</h3><p>The first-visit trial is for first-time customers and is listed as {pricing.first.minutes} minutes, without membership registration. Agree on the task, support and anything you need to bring before visiting.</p></article><article><h3>Additional work & materials</h3><p>Listed prices are session or membership totals. Parts, consumables, materials and specialist work may cost extra. Ask for the total applicable to your project before proceeding.</p></article><article><h3>Pass & membership conditions</h3><p>Confirm the pass validity start date, booking changes, cancellation rules and any refund or transfer conditions. For membership, confirm usage allowances and joining, renewal and cancellation terms.</p></article><article><h3>Booking & technical consultation</h3><p>Sending an enquiry does not reserve a slot. Confirm the appointment before travelling. Technical diagnosis and advice are paid services, separate from the initial booking enquiry.</p></article></div></section>
  <NextStep title="Not sure which option fits?" text="Send your motorcycle model and intended task. Confirm the suitable plan, available support and costs before booking." label="Ask about your visit" />
</PageLayout>
